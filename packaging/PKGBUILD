# Builds the package from this checkout: run `makepkg -si` in the packaging folder.
pkgname=napkin
pkgver=0.1.0
pkgrel=1
pkgdesc="A natural-language calculator for Linux, at home on Omarchy"
arch=('x86_64' 'aarch64')
url="https://github.com/nerkyator/napkin"
license=('MIT' 'CC-BY-4.0')
depends=('gtk4' 'libadwaita')
makedepends=('cargo')
options=('!lto')

build() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --release --locked -p napkin
}

check() {
  cd "$startdir/.."
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --release --locked -p napkin-engine
}

package() {
  cd "$startdir/.."
  install -Dm755 "$srcdir/target/release/napkin" "$pkgdir/usr/bin/napkin"
  install -Dm644 packaging/napkin.desktop \
    "$pkgdir/usr/share/applications/napkin.desktop"
  install -Dm644 packaging/napkin.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/napkin.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
